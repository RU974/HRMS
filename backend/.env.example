APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ── Audio / video calls ─────────────────────────────────────────────────────
# Calls are peer-to-peer (mesh). Keep the cap small; raise it only with a media server.
CALL_MAX_PARTICIPANTS=4
# How long (seconds) a call may ring before calls:expire-stale marks it missed.
CALL_RINGING_TIMEOUT_SECONDS=60
# Joined participants ping every N seconds; silent for STALE seconds = disconnected.
CALL_HEARTBEAT_INTERVAL_SECONDS=15
CALL_STALE_PARTICIPANT_SECONDS=60
CALL_VIDEO_ENABLED=true
CALL_SCREEN_SHARE_ENABLED=true
CALL_SIGNAL_RETENTION_HOURS=24

# STUN is enough on most networks. TURN is REQUIRED for users behind symmetric NAT or
# strict corporate firewalls — without it those users cannot connect. Run coturn
# (see deploy/coturn/turnserver.conf). CALL_TURN_SECRET must equal coturn's
# static-auth-secret; the API hands each user short-lived credentials derived from it,
# so no TURN credential is ever shipped in the frontend bundle.
CALL_STUN_URLS=stun:stun.l.google.com:19302
CALL_TURN_URLS=
CALL_TURN_SECRET=
CALL_TURN_TTL_SECONDS=3600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Optional OCR for scanned CVs: a shell command with an {input} placeholder that prints the recognised text on stdout.
# Leave empty to only flag scanned files for manual review.
RECRUITMENT_OCR_COMMAND=
RECRUITMENT_OCR_TIMEOUT=60

# Optional AI help for resumes the parser cannot follow. Sends resume text to Anthropic's API, so it is OFF by default.
RECRUITMENT_AI_PARSER=false
ANTHROPIC_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket broadcasting — required for real-time calls and chat)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where THIS server reaches Reverb to publish events (usually loopback, plain http).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Browser origins allowed to open a websocket (comma-separated). NEVER leave "*" in production.
REVERB_ALLOWED_ORIGINS=http://localhost:5173
# Largest single event (bytes) that can be published. Reverb's own default is 10000, which
# silently drops long or non-English chat messages and large WebRTC offers. Keep these high.
REVERB_MAX_REQUEST_SIZE=1000000
REVERB_APP_MAX_MESSAGE_SIZE=1000000

# CORS and SPA settings
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000,::1

# Orbit assistant (Anthropic API)
ANTHROPIC_API_KEY=
ORBIT_MODEL=claude-sonnet-5

# Orbit assistant (Anthropic API)
ANTHROPIC_API_KEY=
ORBIT_MODEL=claude-sonnet-5
