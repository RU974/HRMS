# ZKTeco device settings
DEVICE_IP=192.168.10.251
DEVICE_PORT=4370
COMM_KEY=0
DEVICE_TIMEOUT=10

# Cloud server settings
API_URL=https://hrms.slingshotteck.com/api/v1/auth/biometric-agent/push
# SYNC_USERS_URL is optional — auto-derived from API_URL by replacing /push with /sync-users
# SYNC_USERS_URL=https://hrms.slingshotteck.com/api/v1/auth/biometric-agent/sync-users
API_SECRET=your-agent-secret-here
SSL_VERIFY=true

# Agent behaviour
CLEAR_AFTER_SYNC=true
STATE_FILE=last_sync.json

# Discovery (python agent.py --discover)
# SCAN_SUBNET: first 3 octets to scan e.g. 192.168.1
# Leave blank to auto-detect from DEVICE_IP
# SCAN_SUBNET=192.168.1
SCAN_PORT=4370
SCAN_TIMEOUT=2
SCAN_WORKERS=50
