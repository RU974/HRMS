# ZKTeco device settings — IP/port are used to identify the device on the server
DEVICE_IP=192.168.10.251
DEVICE_PORT=4370
COMM_KEY=0
DEVICE_TIMEOUT=10

# Cloud server settings
API_URL=https://your-server.com/api/v1/auth/biometric-agent/push
API_SECRET=your-agent-secret-here

# Agent behaviour
CLEAR_AFTER_SYNC=true
STATE_FILE=last_sync.json
