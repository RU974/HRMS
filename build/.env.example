VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://127.0.0.1:8000

# Laravel Reverb (WebSocket broadcasting)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# In production the browser connects through your HTTPS proxy on 443 (see deploy/nginx),
# e.g. VITE_REVERB_HOST=hrms.example.com  VITE_REVERB_PORT=443  VITE_REVERB_SCHEME=https
#
# TURN/STUN servers are NOT configured here. The API returns them (with short-lived
# credentials) from GET /api/v1/calls/config — set CALL_TURN_* in the backend .env.
