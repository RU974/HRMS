VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://127.0.0.1:8000

# Laravel Reverb (WebSocket broadcasting)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# TURN server for WebRTC (required for symmetric NAT / enterprise firewalls)
# Recommended: self-hosted coturn OR Twilio TURN (https://www.twilio.com/stun-turn)
# Leave blank to use STUN-only (works on most networks, not all)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
